            "custom-liquid": "{%- assign versand_seite = pages['versandkosten'] -%}\n{%- if request.locale.iso_code == 'de' -%}\n  {%- assign versand_label = 'zzgl. Versandkosten' -%}\n  {%- assign versand_close = 'Schließen' -%}\n{%- else -%}\n  {%- assign versand_label = 'plus shipping' -%}\n  {%- assign versand_close = 'Close' -%}\n{%- endif -%}\n\n<button type=\"button\" class=\"oak-versand-link\" id=\"oak-versand-link\">{{ versand_label }}</button>\n\n<dialog id=\"oak-versand-dialog\" class=\"oak-versand-dialog\">\n  <div class=\"oak-versand-inner\">\n    <button type=\"button\" class=\"oak-versand-close\" aria-label=\"{{ versand_close }}\"\n      onclick=\"this.closest('dialog').close()\">&times;</button>\n    <h2 class=\"oak-versand-title\">{{ versand_seite.title }}</h2>\n    <div class=\"rte\">{{ versand_seite.content }}</div>\n  </div>\n</dialog>\n\n<style>\n  .oak-versand-link {\n    background: none; border: 0; padding: 0; margin: 0;\n    font: inherit; color: inherit;\n    text-decoration: underline; cursor: pointer;\n  }\n  .oak-versand-dialog {\n    border: 0; padding: 0; width: 90vw; max-width: 640px;\n    max-height: 80vh; overflow: auto;\n  }\n  .oak-versand-dialog::backdrop { background: rgba(0, 0, 0, 0.5); }\n  .oak-versand-inner { position: relative; padding: 32px 24px 24px; }\n  .oak-versand-close {\n    position: absolute; top: 8px; right: 12px;\n    background: none; border: 0; font-size: 28px;\n    line-height: 1; cursor: pointer; color: inherit;\n  }\n  .oak-versand-title { margin-top: 0; }\n  .oak-versand-dialog table { width: 100%; border-collapse: collapse; }\n\n  /* Linien */\n  .oak-versand-dialog th,\n  .oak-versand-dialog td {\n    border: 0 !important;\n    border-bottom: 1px solid rgba(0, 0, 0, 0.12) !important;\n  }\n  .oak-versand-dialog tr.oak-kopf > * {\n    border-bottom: 2px solid rgba(0, 0, 0, 0.4) !important;\n  }\n  .oak-versand-dialog tr.oak-land-zeile > * {\n    border-top: 1px solid rgba(0, 0, 0, 0.3) !important;\n  }\n\n  /* Flaggen */\n  .oak-flagge {\n    display: inline-block; width: 20px; height: 15px;\n    margin-right: 8px; vertical-align: -2px;\n    border-radius: 2px; object-fit: cover;\n    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1);\n  }\n</style>\n\n<script>\n  (function () {\n    var dialog = document.getElementById('oak-versand-dialog');\n    var link = document.getElementById('oak-versand-link');\n    if (!dialog || !link) return;\n\n    link.addEventListener('click', function () { dialog.showModal(); });\n    dialog.addEventListener('click', function (e) {\n      if (e.target === dialog) dialog.close();\n    });\n\n    /* --- Flaggen und Linien in der Tabelle --- */\n    var laender = {\n      'deutschland': 'de', 'germany': 'de',\n      'schweiz': 'ch', 'switzerland': 'ch',\n      'vereinigtes königreich': 'gb', 'united kingdom': 'gb',\n      'vereinigte staaten': 'us', 'united states': 'us',\n      'kanada': 'ca', 'canada': 'ca',\n      'europäische union': 'eu', 'european union': 'eu',\n      'australien': 'au', 'australia': 'au',\n      'neuseeland': 'nz', 'new zealand': 'nz'\n    };\n\n    function euFlagge() {\n      var sterne = '';\n      for (var i = 0; i < 12; i++) {\n        var w = i * Math.PI / 6;\n        sterne += '<circle cx=\"' + (20 + 9 * Math.cos(w)).toFixed(2) +\n                  '\" cy=\"' + (15 + 9 * Math.sin(w)).toFixed(2) +\n                  '\" r=\"1.4\" fill=\"#ffcc00\"/>';\n      }\n      return 'data:image/svg+xml,' + encodeURIComponent(\n        '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 30\">' +\n        '<rect width=\"40\" height=\"30\" fill=\"#003399\"/>' + sterne + '</svg>'\n      );\n    }\n\n    dialog.querySelectorAll('table').forEach(function (tabelle) {\n      if (tabelle.rows.length) tabelle.rows[0].classList.add('oak-kopf');\n\n      Array.prototype.forEach.call(tabelle.rows, function (zeile, index) {\n        if (index === 0 || !zeile.cells.length) return;\n        var zelle = zeile.cells[0];\n        var name = zelle.textContent.replace(/\\*/g, '').trim().toLowerCase();\n        var code = laender[name];\n        if (!code) return;\n\n        var img = document.createElement('img');\n        img.className = 'oak-flagge';\n        img.alt = '';\n        img.width = 20;\n        img.height = 15;\n        img.src = code === 'eu'\n          ? euFlagge()\n          : 'https://cdn.shopify.com/static/images/flags/' + code + '.svg?width=40';\n\n        var walker = document.createTreeWalker(zelle, NodeFilter.SHOW_TEXT);\n        var text = walker.nextNode();\n        while (text && !text.nodeValue.trim()) text = walker.nextNode();\n        if (text) text.parentNode.insertBefore(img, text);\n\n        if (index > 1) zeile.classList.add('oak-land-zeile');\n      });\n    });\n\n    /* --- Link neben dem Steuerhinweis --- */\n    // art 'komma': \"Inklusive Steuern, zzgl. Versandkosten\"\n    // art 'zeile': Link in einer neuen Zeile direkt unter dem Text\n    var regeln = [\n      { muster: /^(Inklusive Steuern|Taxes included|Tax included)\\.?$/i, art: 'komma' },\n      { muster: /Taxes are charged by local authorities/i, art: 'zeile' }\n    ];\n    var bereich = document.querySelector('main') || document.body;\n\n    function sichtbar(el) {\n      return !!(el && el.getClientRects().length);\n    }\n\n    function einsetzen() {\n      if (link.isConnected && link.parentNode.dataset.oakTax) return;\n      var walker = document.createTreeWalker(bereich, NodeFilter.SHOW_TEXT);\n      var node;\n      while ((node = walker.nextNode())) {\n        var text = node.nodeValue.trim();\n        if (!text || !sichtbar(node.parentElement)) continue;\n\n        for (var i = 0; i < regeln.length; i++) {\n          if (!regeln[i].muster.test(text)) continue;\n\n          if (regeln[i].art === 'komma') {\n            node.nodeValue = text.replace(/\\.$/, '') + ', ';\n            node.parentNode.insertBefore(link, node.nextSibling);\n          } else {\n            var br = document.createElement('br');\n            node.parentNode.insertBefore(br, node.nextSibling);\n            node.parentNode.insertBefore(link, br.nextSibling);\n          }\n          node.parentNode.dataset.oakTax = '1';\n          return;\n        }\n      }\n    }\n\n    function start() {\n      einsetzen();\n      new MutationObserver(einsetzen).observe(bereich, { childList: true, subtree: true });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else {\n      start();\n    }\n  })();\n</script>"
