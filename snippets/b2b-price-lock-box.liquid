<!-- snippets/b2b-price-lock-box.liquid -->

{%- doc -%}
  Rendert die Sperr-Box für Besucher ohne Preis-Zugriff: Schloss, Titel, Meldung und zwei Links
  (Anmelden, Händlerkonto beantragen). Texte und Ziele kommen aus der Einstellungsgruppe „B2B Preissperre“.
  Wird nur gerendert, wenn `b2b-price-access` nicht `true` liefert – die Prüfung macht der Aufrufer.

  @param {string} [button_style] - Theme-Button-Stil für Form und Schrift der Links. Defaults to `button-1`.

  @example
  {%- render 'b2b-price-lock-box', button_style: primary_button_style -%}
{%- enddoc -%}

{%- liquid
  assign button_style = button_style | default: 'button-1'

  assign login_url = settings.b2b_price_lock_login_url | default: routes.account_login_url
  assign register_url = settings.b2b_price_lock_register_url | default: '/pages/b2b-registration'
-%}

<div class="b2b-price-lock--root" role="note">
  <div class="b2b-price-lock--intro">
    <span class="b2b-price-lock--icon" aria-hidden="true">
      {%- render 'icons', icon: 'lock' -%}
    </span>

    <div class="b2b-price-lock--text">
      {%- unless settings.b2b_price_lock_heading == blank -%}
        <p class="b2b-price-lock--heading">
          {{- settings.b2b_price_lock_heading -}}
        </p>
      {%- endunless -%}

      {%- unless settings.b2b_price_lock_message == blank -%}
        <div class="b2b-price-lock--message" data-item="rte-content">
          {{- settings.b2b_price_lock_message -}}
        </div>
      {%- endunless -%}
    </div>
  </div>

  <a
    class="b2b-price-lock--button"
    href="{{ login_url }}"
    data-item="{{ button_style }}"
    data-type="login"
  >
    <span>{{- settings.b2b_price_lock_login_label -}}</span>
  </a>

  <a
    class="b2b-price-lock--button"
    href="{{ register_url }}"
    data-item="{{ button_style }}"
    data-type="register"
  >
    <span>{{- settings.b2b_price_lock_register_label -}}</span>
  </a>
</div>

{% stylesheet %}
  /* Maße und Farben aus dem freigegebenen Entwurf V4 („Akzent mit 2 Buttons“) */
  .b2b-price-lock--root {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--2);
    width: 100%;
    padding: var(--spacing--3);
    border: 1px solid #f7af36;
    background-color: #fef3e0;
    color: var(--color--body);
    text-align: left;

    /* Auf der Warenkorbseite rechtsbündig in der Breite der Infospalte, statt über die ganze Seite */
    .cart--root[data-view='desktop'] & {
      max-width: 300px;
    }
  }

  /* laura.css setzt alle Produktblöcke mit !important auf 10px, der Entwurf verlangt 16px zur Farbauswahl */
  .product-form--block:has(> .b2b-price-lock--root) {
    margin-top: var(--spacing--3) !important;
  }

  .b2b-price-lock--intro {
    display: flex;
    gap: var(--spacing--2);
    align-items: flex-start;
  }

  .b2b-price-lock--icon {
    display: flex;
    flex-shrink: 0;

    .icon--lock {
      width: 14px;
      height: 18px;
    }
  }

  .b2b-price-lock--text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--0);
    min-width: 0;
  }

  .b2b-price-lock--heading {
    margin: 0;
    font-family: var(--font--nav--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    text-transform: none;
  }

  .b2b-price-lock--message {
    font-family: var(--font--paragraph--family);
    font-size: 14px;
    line-height: 21px;
    overflow-wrap: anywhere;
  }

  /* Über die Root-Klasse, damit die Farben gegen die Theme-Regeln für data-item="button-1" gewinnen */
  .b2b-price-lock--root .b2b-price-lock--button {
    width: 100%;

    &[data-type='login'] {
      /* Gleiche Farben wie der gelbe Warenkorb-Button aus laura.css */
      --button--color: #000000;
      --button--bg-color: #f7af36;
      --button--border-color: #f7af36;
      --button--bg-color--hover: #f9c772;
    }

    &[data-type='register'] {
      --button--color: var(--color--body);
      --button--bg-color: #ffffff;
      --button--border-color: var(--color--body);
      --button--bg-color--hover: var(--bg-color--light);
    }

    &:focus-visible {
      outline: 2px solid var(--color--body);
      outline-offset: 2px;
    }
  }
{% endstylesheet %}
