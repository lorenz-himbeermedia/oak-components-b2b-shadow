<!-- snippets/b2b-price-lock-box.liquid -->

{%- doc -%}
  Rendert die Sperr-Box für Besucher ohne Preis-Zugriff: Schloss, Titel, Meldung und zwei Links
  (Anmelden, Händlerkonto beantragen). Texte und Ziele kommen aus der Einstellungsgruppe „B2B Preissperre“.
  Wird nur gerendert, wenn `b2b-price-access` nicht `true` liefert – die Prüfung macht der Aufrufer.
  Inhalt je Zustand aus `b2b-account-status`: Gast wie oben, Antrag in Prüfung mit Uhr und ohne Links,
  kein Antrag nur mit dem Link zum Händlerkonto.

  @param {string} [button_style] - Theme-Button-Stil für Form und Schrift der Links. Defaults to `button-1`.

  @example
  {%- render 'b2b-price-lock-box', button_style: primary_button_style -%}
{%- enddoc -%}

{%- capture account_status -%}{%- render 'b2b-account-status' -%}{%- endcapture -%}

{%- liquid
  assign button_style = button_style | default: 'button-1'

  assign login_url = settings.b2b_price_lock_login_url | default: routes.account_login_url
  assign register_url = settings.b2b_price_lock_register_url | default: '/pages/b2b-registration'

  case account_status
    when 'pending'
      assign lock_icon = 'clock'
      assign lock_heading = settings.b2b_pending_label
      assign lock_message = settings.b2b_lock_pending_message
    when 'no_application'
      assign lock_icon = 'lock'
      assign lock_heading = settings.b2b_lock_no_application_heading
      assign lock_message = settings.b2b_lock_no_application_message
    else
      assign lock_icon = 'lock'
      assign lock_heading = settings.b2b_price_lock_heading
      assign lock_message = settings.b2b_price_lock_message
  endcase
-%}

<div class="b2b-price-lock--root" data-status="{{ account_status }}" role="note">
  <div class="b2b-price-lock--intro">
    <span class="b2b-price-lock--icon" aria-hidden="true">
      {%- render 'icons', icon: lock_icon -%}
    </span>

    <div class="b2b-price-lock--text">
      {%- unless lock_heading == blank -%}
        <p class="b2b-price-lock--heading">
          {{- lock_heading -}}
        </p>
      {%- endunless -%}

      {%- unless lock_message == blank -%}
        <div class="b2b-price-lock--message" data-item="rte-content">
          {{- lock_message -}}
        </div>
      {%- endunless -%}
    </div>
  </div>

  {%- if account_status == 'guest' -%}
    <a
      class="b2b-price-lock--button"
      href="{{ login_url }}"
      data-item="{{ button_style }}"
      data-type="login"
    >
      <span>{{- settings.b2b_price_lock_login_label -}}</span>
    </a>
  {%- endif -%}

  {%- unless account_status == 'pending' -%}
    <a
      class="b2b-price-lock--button"
      href="{{ register_url }}"
      data-item="{{ button_style }}"
      data-type="register"
    >
      <span>{{- settings.b2b_price_lock_register_label -}}</span>
    </a>
  {%- endunless -%}
</div>

{% stylesheet %}
  /* Maße und Farben aus dem freigegebenen Entwurf V4 („Akzent mit 2 Buttons“) */
  .b2b-price-lock--root {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--2);
    width: 100%;
    padding: var(--spacing--3);
    border: 1px solid #f7af36;
    background-color: #fef3e0;
    color: var(--color--body);
    text-align: left;

    /* Auf der Warenkorbseite rechtsbündig in der Breite der Infospalte, statt über die ganze Seite */
    .cart--root[data-view='desktop'] & {
      max-width: 300px;
    }

    /* Antrag in Prüfung: neutral grau statt Akzent, Entwurf V6 */
    &[data-status='pending'] {
      border-color: rgba(33, 33, 33, 0.1);
      background-color: #f1f1f1;
    }
  }

  .b2b-price-lock--intro {
    display: flex;
    gap: var(--spacing--2);
    align-items: flex-start;
  }

  .b2b-price-lock--icon {
    display: flex;
    flex-shrink: 0;

    .icon--lock {
      width: 14px;
      height: 18px;
    }

    .icon--clock {
      width: 18px;
      height: 18px;
    }
  }

  .b2b-price-lock--text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--0);
    min-width: 0;
  }

  .b2b-price-lock--heading {
    margin: 0;
    font-family: var(--font--nav--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    text-transform: none;
  }

  .b2b-price-lock--message {
    font-family: var(--font--paragraph--family);
    font-size: 14px;
    line-height: 21px;
    overflow-wrap: anywhere;
  }

  /* Über die Root-Klasse, damit die Farben gegen die Theme-Regeln für data-item="button-1" gewinnen */
  .b2b-price-lock--root .b2b-price-lock--button {
    width: 100%;

    &[data-type='login'] {
      /* Gleiche Farben wie der gelbe Warenkorb-Button aus laura.css */
      --button--color: #000000;
      --button--bg-color: #f7af36;
      --button--border-color: #f7af36;
      --button--bg-color--hover: #f9c772;
    }

    &[data-type='register'] {
      --button--color: var(--color--body);
      --button--bg-color: #ffffff;
      --button--border-color: var(--color--body);
      --button--bg-color--hover: var(--bg-color--light);
    }

    &:focus-visible {
      outline: 2px solid var(--color--body);
      outline-offset: 2px;
    }
  }

  /* Ohne Antrag ist der Händlerkonto-Link der einzige und deshalb gefüllt wie der Warenkorb-Button */
  .b2b-price-lock--root[data-status='no_application'] .b2b-price-lock--button[data-type='register'] {
    --button--color: #000000;
    --button--bg-color: #f7af36;
    --button--border-color: #f7af36;
    --button--bg-color--hover: #f9c772;
  }
{% endstylesheet %}
