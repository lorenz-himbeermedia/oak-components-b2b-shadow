{%- doc -%}
  OAK USP banner: headline, short text, a row of USP columns with icons and a button.
  Every text, the link and the colours are editable in the theme editor.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign accent = s.accent-color | default: '#ffffff'
  assign bg = s.background-color | default: '#000000'
  assign fg = s.text-color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section.id }} .oak-usp {
    background: {{ bg }};
    color: {{ fg }};
    padding: {{ s.padding-top }}px 0 {{ s.padding-bottom }}px;
  }
  #shopify-section-{{ section.id }} .oak-usp__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 80px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .oak-usp__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 64px;
  }
  #shopify-section-{{ section.id }} .oak-usp__intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }
  #shopify-section-{{ section.id }} .oak-usp__overline {
    margin: 0;
    font-family: var(--font--paragraph--family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: {{ fg }};
    opacity: 0.68;
  }
  #shopify-section-{{ section.id }} .oak-usp__heading {
    margin: 0;
    font-family: var(--font--heading--family);
    font-weight: var(--font--heading--weight);
    text-transform: var(--font--heading--uppercase);
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.08;
    color: {{ fg }};
  }
  #shopify-section-{{ section.id }} .oak-usp__text {
    margin: 0;
    max-width: 440px;
    font-family: var(--font--paragraph--family);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.5;
    color: {{ fg }};
    opacity: 0.82;
  }
  #shopify-section-{{ section.id }} .oak-usp__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .oak-usp__item {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px 32px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }
  #shopify-section-{{ section.id }} .oak-usp__item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  #shopify-section-{{ section.id }} .oak-usp__item:last-child {
    padding-right: 0;
  }
  #shopify-section-{{ section.id }} .oak-usp__icon {
    width: 44px;
    height: 44px;
    color: {{ accent }};
  }
  #shopify-section-{{ section.id }} .oak-usp__title {
    margin: 0;
    font-family: var(--font--heading--family);
    font-weight: var(--font--heading--weight);
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.3;
    color: {{ fg }};
  }
  #shopify-section-{{ section.id }} .oak-usp__foot {
    display: flex;
  }
  #shopify-section-{{ section.id }} .oak-usp__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 30px;
    box-sizing: border-box;
    background: {{ accent }};
    color: {{ bg }};
    font-family: var(--font--paragraph--family);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .oak-usp__button:hover {
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .oak-usp__button:focus-visible {
    outline: 2px solid {{ accent }};
    outline-offset: 3px;
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .oak-usp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-bottom: 0;
    }
    #shopify-section-{{ section.id }} .oak-usp__item,
    #shopify-section-{{ section.id }} .oak-usp__item:first-child,
    #shopify-section-{{ section.id }} .oak-usp__item:last-child {
      padding: 28px 20px;
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    #shopify-section-{{ section.id }} .oak-usp__item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    #shopify-section-{{ section.id }} .oak-usp__item:nth-child(even) {
      padding-right: 0;
    }
    #shopify-section-{{ section.id }} .oak-usp__icon {
      width: 36px;
      height: 36px;
    }
    #shopify-section-{{ section.id }} .oak-usp__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<div class="oak-usp">
  <div class="oak-usp__inner">
    {%- if s.overline != blank or s.heading != blank or s.text != blank -%}
      <div class="oak-usp__head">
        <div class="oak-usp__intro">
          {%- if s.overline != blank -%}
            <p class="oak-usp__overline">{{ s.overline | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="oak-usp__heading">{{ s.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if s.text != blank -%}
          <p class="oak-usp__text">{{ s.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="oak-usp__grid">
        {%- for block in section.blocks -%}
          <li class="oak-usp__item" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'precision' -%}
                <svg class="oak-usp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path></svg>
              {%- when 'trail' -%}
                <svg class="oak-usp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 20l7-11 4 6 3-4 6 9z"></path><circle cx="17" cy="5" r="2"></circle></svg>
              {%- when 'package' -%}
                <svg class="oak-usp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"></path><path d="M3 8l9 5 9-5"></path><path d="M12 13v8"></path></svg>
              {%- when 'camera' -%}
                <svg class="oak-usp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7l2-3h4l2 3"></path><circle cx="12" cy="13.5" r="3.5"></circle></svg>
            {%- endcase -%}
            {%- if block.settings.title != blank -%}
              <p class="oak-usp__title">{{ block.settings.title | escape | newline_to_br }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.button-text != blank -%}
      <div class="oak-usp__foot">
        <a class="oak-usp__button" href="{{ s.button-link | default: routes.all_products_collection_url }}">
          <span>{{ s.button-text | escape }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "OAK USP banner",
  "class": "section--oak-usp-banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "overline", "label": "Overline", "default": "OAK for dealers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision MTB components for your shop." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Engineered in Germany, tested on the trail and packed ready for your shelf." },
    { "type": "text", "id": "button-text", "label": "Button text", "default": "Shop the range" },
    { "type": "url", "id": "button-link", "label": "Button link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background-color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text-color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent-color", "label": "Icons and button", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-top", "label": "Spacing above", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-bottom", "label": "Spacing below", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "precision", "label": "Precision" },
            { "value": "trail", "label": "Trail" },
            { "value": "package", "label": "Package" },
            { "value": "camera", "label": "Camera" },
            { "value": "none", "label": "None" }
          ],
          "default": "precision"
        },
        { "type": "textarea", "id": "title", "label": "Text", "default": "USP text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OAK USP banner",
      "blocks": [
        { "type": "usp", "settings": { "icon": "precision", "title": "German performance & engineering excellence" } },
        { "type": "usp", "settings": { "icon": "trail", "title": "We ride & create!\nDeveloped by bikers for bikers" } },
        { "type": "usp", "settings": { "icon": "package", "title": "Unique innovative products in smart packaging" } },
        { "type": "usp", "settings": { "icon": "camera", "title": "Premium content available" } }
      ]
    }
  ]
}
{% endschema %}